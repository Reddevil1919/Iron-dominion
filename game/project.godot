config_version=5

[application]

config/name="Iron Dominion"
run/main_scene="res://Scenes/Battlefield.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="IronDominion.Game"
project/solution_directory=".."

[input]

camera_pan_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65),
Object(InputEventKey,"keycode":4194319)]
}
camera_pan_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68),
Object(InputEventKey,"keycode":4194321)]
}
camera_pan_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87),
Object(InputEventKey,"keycode":4194320)]
}
camera_pan_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83),
Object(InputEventKey,"keycode":4194322)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
